{
 "doctype": "DocType",
 "name": "Sports Player",
 "module": "Sports App",
 "engine": "InnoDB",
 "custom": 0,
 "track_changes": 1,
 "allow_rename": 0,
 "field_order": [
  "full_name",
  "company",
  "customer",
  "portal_user",
  "guardian_user",
  "registration_program",
  "source_registration",
  "player_details",
  "player_photo",
  "first_name",
  "last_name",
  "birth_date",
  "gender",
  "preferred_position",
  "preferred_foot",
  "school_name",
  "contact_email",
  "contact_phone",
  "medical_notes",
  "guardian_details",
  "guardian_name",
  "guardian_relationship",
  "guardian_phone",
  "guardian_alt_phone",
  "guardian_email",
  "home_address",
  "emergency_details",
  "emergency_contact_name",
  "emergency_contact_phone",
  "consent_details",
  "medical_consent",
  "media_consent",
  "terms_accepted",
  "registered_on",
  "request_key",
  "request_hash"
 ],
 "fields": [
  {
   "fieldname": "full_name",
   "label": "Player name",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "read_only_depends_on": "eval:doc.first_name || doc.last_name"
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "customer",
   "label": "Customer",
   "fieldtype": "Link",
   "options": "Customer",
   "read_only": 1,
   "unique": 1,
   "no_copy": 1
  },
  {
   "fieldname": "portal_user",
   "label": "Self-service User",
   "fieldtype": "Link",
   "options": "User",
   "read_only": 1,
   "unique": 1,
   "no_copy": 1
  },
  {
   "fieldname": "registration_program",
   "label": "Registration program",
   "fieldtype": "Link",
   "options": "Sports Program",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "birth_date",
   "label": "Date of birth",
   "fieldtype": "Date"
  },
  {
   "fieldname": "contact_email",
   "label": "Player email",
   "fieldtype": "Data",
   "options": "Email",
   "description": "A unique player email for the future self-service account; separate from the guardian email."
  },
  {
   "fieldname": "contact_phone",
   "label": "Player / contact phone",
   "fieldtype": "Data"
  },
  {
   "fieldname": "guardian_name",
   "label": "Parent / guardian name",
   "fieldtype": "Data"
  },
  {
   "fieldname": "guardian_phone",
   "label": "Parent / guardian phone",
   "fieldtype": "Data"
  },
  {
   "fieldname": "registered_on",
   "label": "Registered on",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "request_key",
   "label": "Registration request",
   "fieldtype": "Data",
   "hidden": 1,
   "read_only": 1,
   "unique": 1,
   "no_copy": 1
  },
  {
   "fieldname": "request_hash",
   "label": "Request fingerprint",
   "fieldtype": "Data",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "player_details",
   "label": "The player",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "first_name",
   "label": "First name",
   "fieldtype": "Data"
  },
  {
   "fieldname": "last_name",
   "label": "Last name",
   "fieldtype": "Data"
  },
  {
   "fieldname": "gender",
   "label": "Gender",
   "fieldtype": "Select",
   "options": "\nBoy\nGirl"
  },
  {
   "fieldname": "preferred_position",
   "label": "Preferred position",
   "fieldtype": "Select",
   "options": "\nNo preference\nGoalkeeper\nDefender\nMidfielder\nWinger\nStriker\nNot sure yet"
  },
  {
   "fieldname": "school_name",
   "label": "School name",
   "fieldtype": "Data"
  },
  {
   "fieldname": "medical_notes",
   "label": "Medical notes",
   "fieldtype": "Small Text",
   "description": "Allergies or conditions coaches should know about. Private player information."
  },
  {
   "fieldname": "guardian_details",
   "label": "Parent / guardian",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "guardian_relationship",
   "label": "Relationship to player",
   "fieldtype": "Data"
  },
  {
   "fieldname": "guardian_alt_phone",
   "label": "Alternative guardian phone",
   "fieldtype": "Data"
  },
  {
   "fieldname": "guardian_email",
   "label": "Guardian email",
   "fieldtype": "Data",
   "options": "Email"
  },
  {
   "fieldname": "home_address",
   "label": "Home address",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "emergency_details",
   "label": "Emergency contact (if different)",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "emergency_contact_name",
   "label": "Emergency contact name",
   "fieldtype": "Data"
  },
  {
   "fieldname": "emergency_contact_phone",
   "label": "Emergency contact phone",
   "fieldtype": "Data"
  },
  {
   "fieldname": "consent_details",
   "label": "Consent choices",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "medical_consent",
   "label": "Emergency medical attention consent recorded",
   "fieldtype": "Check",
   "description": "Permission to seek medical help if the guardian cannot be reached."
  },
  {
   "fieldname": "media_consent",
   "label": "Photo and video permission recorded",
   "fieldtype": "Check",
   "description": "Permission to use academy training/match photos and video publicly. Optional; never preselected."
  },
  {
   "fieldname": "terms_accepted",
   "label": "Academy terms acceptance recorded",
   "fieldtype": "Check",
   "description": "Record only consent actually supplied by the guardian. The prototype does not establish a contract or take payment."
  },
  {
   "fieldname": "source_registration",
   "label": "Source registration",
   "fieldtype": "Link",
   "options": "Sports Registration",
   "read_only": 1,
   "no_copy": 1,
   "unique": 1
  },
  {
   "fieldname": "player_photo",
   "label": "Player image",
   "fieldtype": "Attach Image",
   "read_only": 1
  },
  {
   "fieldname": "guardian_user",
   "fieldtype": "Link",
   "options": "User",
   "label": "Guardian self-service account",
   "read_only": 1,
   "description": "Server-owned guardian identity reference. May be shared by siblings; does not authorize portal access."
  },
  {
   "fieldname": "preferred_foot",
   "label": "Preferred foot",
   "fieldtype": "Select",
   "options": "\nLeft\nRight\nBoth\nNot specified",
   "description": "Optional sport-specific profile preference. Updated by authorised staff."
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 0,
   "import": 1
  },
  {
   "role": "Sports Academy Administrator",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 0,
   "import": 1
  },
  {
   "role": "Sports Registrar",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 0
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "title_field": "full_name",
 "search_fields": "full_name,company",
 "autoname": "",
 "allow_import": 1
}
