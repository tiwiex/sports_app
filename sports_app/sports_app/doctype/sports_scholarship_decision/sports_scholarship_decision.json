  {
   "fieldname": "trip_benefit",
   "label": "Trip benefit",
   "fieldtype": "Check",
   "reqd": 0,
   "read_only": 0
  },
  {
   "fieldname": "trial_benefit",
   "label": "Trial benefit",
   "fieldtype": "Check",
   "reqd": 0,
   "read_only": 0
  },
  {
   "fieldname": "tournament_benefit",
   "label": "Tournament benefit",
   "fieldtype": "Check",
   "reqd": 0,
   "read_only": 0
  },
  {
   "fieldname": "approved_by",
