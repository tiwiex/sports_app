   "share": 0,
   "export": 0,
   "report": 1
  },
  {
   "role": "Sports Academy Administrator",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "delete": 0,
   "share": 0,
   "export": 0,
   "report": 1
  },
  {
   "role": "Sports Finance",
   "read": 1,
   "write": 0,
   "create": 0,
   "submit": 0,
   "cancel": 0,
   "delete": 0,
