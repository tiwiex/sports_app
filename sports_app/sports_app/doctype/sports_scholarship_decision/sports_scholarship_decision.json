  {
   "fieldname": "approved_on",
   "label": "Approved on",
   "fieldtype": "Datetime",
   "reqd": 0,
   "read_only": 1
  },
  {
   "fieldname": "revocation_reason",
   "label": "Revocation reason",
   "fieldtype": "Small Text",
   "reqd": 0,
   "read_only": 0,
   "allow_on_submit": 1
  },
  {
   "fieldname": "revoked_by",
   "label": "Revoked by",
   "fieldtype": "Link",
   "reqd": 0,
   "read_only": 1,
   "options": "User"
  },
  {
   "fieldname": "revoked_on",
   "label": "Revoked on",
   "fieldtype": "Datetime",
   "reqd": 0,
   "read_only": 1
  }
 ],
