   "fieldtype": "Link",
   "reqd": 1,
   "read_only": 0,
   "options": "Sports Enrollment"
  },
  {
   "fieldname": "player",
   "label": "Player",
   "fieldtype": "Link",
   "reqd": 1,
   "read_only": 1,
   "options": "Sports Player"
  },
  {
