{
 "doctype": "DocType",
 "name": "Sports Academy Settings",
 "module": "Sports App",
 "engine": "InnoDB",
 "custom": 0,
 "track_changes": 1,
 "field_order": [
  "academy_name",
  "company",
  "currency",
  "timezone",
  "registration_section",
  "registration_prefix",
  "registration_digits",
  "player_starting_sequence",
  "enrollment_naming_series",
  "default_enrollment_status",
  "default_program",
  "default_group",
  "fee_section",
  "monthly_fees_enabled",
  "default_monthly_fee",
  "enrollment_payment_section",
  "enrollment_payments_enabled",
  "payment_review_emails",
  "enrollment_payment_currency",
  "enrollment_registration_fee",
  "enrollment_jersey_fee",
  "enrollment_monthly_fee",
  "enrollment_bank_account",
  "enrollment_receivable_account",
  "enrollment_registration_item",
  "enrollment_jersey_item"
 ],
 "fields": [
  {
   "fieldname": "academy_name",
   "label": "Academy name",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "currency",
   "label": "Fee currency",
   "fieldtype": "Link",
   "options": "Currency",
   "reqd": 1
  },
  {
   "fieldname": "timezone",
   "label": "Academy timezone",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "registration_section",
   "label": "Registration defaults",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "registration_prefix",
   "label": "Player ID prefix",
   "fieldtype": "Data",
   "reqd": 1,
   "description": "For example MSA: MSA26-08001. Year/month are assigned by the backend; one continuous player counter spans months and years. Existing IDs stay unchanged.",
   "default": "MSA"
  },
  {
   "fieldname": "registration_digits",
   "label": "Player sequence digits",
   "fieldtype": "Int",
   "default": 3,
   "reqd": 1,
   "description": "3\u201310 minimum digits for the continuous player sequence. This is independent of enrollment application naming."
  },
  {
   "fieldname": "default_enrollment_status",
   "label": "Default enrollment status",
   "fieldtype": "Select",
   "options": "Pending\nActive",
   "default": "Pending",
   "reqd": 1
  },
  {
   "fieldname": "default_program",
   "label": "Default program",
   "fieldtype": "Link",
   "options": "Sports Program",
   "reqd": 1
  },
  {
   "fieldname": "default_group",
   "label": "Default group",
   "fieldtype": "Link",
   "options": "Sports Group"
  },
  {
   "fieldname": "fee_section",
   "label": "Fee defaults",
   "fieldtype": "Section Break",
   "description": "Defaults for future fee-plan setup. Saving settings does not generate charges or accounting documents."
  },
  {
   "fieldname": "monthly_fees_enabled",
   "label": "Monthly fees enabled",
   "fieldtype": "Check",
   "default": 1
  },
  {
   "fieldname": "default_monthly_fee",
   "label": "Default monthly fee",
   "fieldtype": "Currency",
   "options": "currency",
   "depends_on": "monthly_fees_enabled"
  },
  {
   "fieldname": "enrollment_payment_section",
   "label": "Website enrollment payment setup",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "enrollment_payments_enabled",
   "label": "Website enrollment payments enabled",
   "fieldtype": "Check",
   "default": 0
  },
  {
   "fieldname": "payment_review_emails",
   "label": "Payment review email addresses",
   "fieldtype": "Small Text",
   "description": "Comma-separated email addresses to notify when an applicant reports payment. Leave blank to disable. Recipients still need their normal Finance approval permissions."
  },
  {
   "fieldname": "enrollment_payment_currency",
   "label": "Enrollment payment currency",
   "fieldtype": "Link",
   "options": "Currency"
  },
  {
   "fieldname": "enrollment_registration_fee",
   "label": "Initial registration fee",
   "fieldtype": "Currency",
   "options": "enrollment_payment_currency"
  },
  {
   "fieldname": "enrollment_jersey_fee",
   "label": "Jersey fee (2 sets)",
   "fieldtype": "Currency",
   "options": "enrollment_payment_currency"
  },
  {
   "fieldname": "enrollment_monthly_fee",
   "label": "Monthly fee (information only)",
   "fieldtype": "Currency",
   "options": "enrollment_payment_currency"
  },
  {
   "fieldname": "enrollment_bank_account",
   "label": "Enrollment bank account",
   "fieldtype": "Link",
   "options": "Bank Account"
  },
  {
   "fieldname": "enrollment_receivable_account",
   "label": "Enrollment receivable account",
   "fieldtype": "Link",
   "options": "Account"
  },
  {
   "fieldname": "enrollment_registration_item",
   "label": "Registration fee item",
   "fieldtype": "Link",
   "options": "Item"
  },
  {
   "fieldname": "enrollment_jersey_item",
   "label": "Jersey fee item",
   "fieldtype": "Link",
   "options": "Item"
  },
  {
   "fieldname": "enrollment_naming_series",
   "label": "Enrollment naming series",
   "fieldtype": "Data",
   "default": "MSA-ENR-.YYYY.-.#####",
   "reqd": 1,
   "description": "New application references only. For example MSA-ENR-.YYYY.-.##### produces MSA-ENR-2026-00001. Optional year; 4-10 counter digits. Existing references and invoice numbers stay unchanged."
  },
  {
   "fieldname": "player_starting_sequence",
   "label": "Player starting sequence",
   "fieldtype": "Data",
   "default": "1",
   "description": "Minimum sequence for new players, for example 126 after legacy number 125. Existing issued/imported numbers take precedence; lowering this never resets numbering. Prefix, year and month are separate. Existing IDs stay unchanged."
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 0
  },
  {
   "role": "Sports Academy Administrator",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 0
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "issingle": 1
}
